```yaml
#cloud-config

hostname: docker-host
manage_etc_hosts: true

# ============================================================
# UTILISATEURS
# ============================================================

users:

  # ----------------------------------------------------------
  # Administrateur système
  # ----------------------------------------------------------

  - name: admin
    gecos: Administrateur système
    shell: /bin/bash
    groups:
      - sudo
    sudo:
      - "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAA...REMPLACER_PAR_TA_CLE_SSH

  # ----------------------------------------------------------
  # Utilisateur dédié aux services Docker
  # ----------------------------------------------------------

  - name: docker
    gecos: Utilisateur Docker
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAA...REMPLACER_PAR_TA_CLE_SSH


# ============================================================
# PAQUETS DE BASE
# ============================================================

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - lsb-release
  - git
  - vim
  - nano
  - htop
  - wget
  - unzip
  - jq
  - qemu-guest-agent


# ============================================================
# INSTALLATION ET CONFIGURATION
# ============================================================

runcmd:

  # ==========================================================
  # DOCKER
  # ==========================================================

  # Création du répertoire pour les clés APT
  - install -m 0755 -d /etc/apt/keyrings

  # Clé officielle Docker
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc

  - chmod a+r /etc/apt/keyrings/docker.asc

  # Dépôt Docker officiel
  - bash -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo ${VERSION_CODENAME}) stable" > /etc/apt/sources.list.d/docker.list'

  # Mise à jour des dépôts
  - apt-get update

  # Installation Docker Engine + Docker Compose
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  # Activation Docker
  - systemctl enable docker.service
  - systemctl enable containerd.service
  - systemctl start docker

  # Ajouter l'utilisateur docker au groupe Docker
  - usermod -aG docker docker


  # ==========================================================
  # RÉPERTOIRES
  # ==========================================================

  - mkdir -p /opt/repository

  - mkdir -p /opt/docker
  - mkdir -p /opt/traefik
  - mkdir -p /opt/apps
  - mkdir -p /opt/data


  # ==========================================================
  # CLONAGE DU REPOSITORY GITHUB
  # ==========================================================

  # Supprimer une ancienne copie éventuelle
  - rm -rf /opt/repository/*

  # Cloner le repository
  - git clone https://github.com/UTILISATEUR/MON-REPOSITORY.git /opt/repository


  # ==========================================================
  # COPIE DES DOCKER-COMPOSE
  # ==========================================================

  # Docker
  - cp /opt/repository/docker/docker-compose.yml /opt/docker/docker-compose.yml

  # Traefik
  - cp /opt/repository/traefik/docker-compose.yml /opt/traefik/docker-compose.yml

  # Applications
  - cp /opt/repository/apps/docker-compose.yml /opt/apps/docker-compose.yml

  # Data
  - cp /opt/repository/data/docker-compose.yml /opt/data/docker-compose.yml


  # ==========================================================
  # PROPRIÉTÉ DES FICHIERS
  # ==========================================================

  - chown -R docker:docker /opt/repository

  - chown -R docker:docker /opt/docker
  - chown -R docker:docker /opt/traefik
  - chown -R docker:docker /opt/apps
  - chown -R docker:docker /opt/data


  # ==========================================================
  # PERMISSIONS
  # ==========================================================

  - chmod 750 /opt/repository

  - chmod 750 /opt/docker
  - chmod 750 /opt/traefik
  - chmod 750 /opt/apps
  - chmod 750 /opt/data

  - chmod 640 /opt/docker/docker-compose.yml
  - chmod 640 /opt/traefik/docker-compose.yml
  - chmod 640 /opt/apps/docker-compose.yml
  - chmod 640 /opt/data/docker-compose.yml


  # ==========================================================
  # QEMU GUEST AGENT
  # ==========================================================

  - systemctl enable --now qemu-guest-agent


  # ==========================================================
  # VÉRIFICATION DOCKER
  # ==========================================================

  - docker --version
  - docker compose version


  # ==========================================================
  # VÉRIFICATION UTILISATEUR DOCKER
  # ==========================================================

  - su - docker -c 'docker version'
  - su - docker -c 'docker compose version'


  # ==========================================================
  # VALIDATION DES DOCKER-COMPOSE
  # ==========================================================

  - su - docker -c 'cd /opt/docker && docker compose config'
  - su - docker -c 'cd /opt/traefik && docker compose config'
  - su - docker -c 'cd /opt/apps && docker compose config'
  - su - docker -c 'cd /opt/data && docker compose config'


# ============================================================
# FICHIERS DE DOCUMENTATION
# ============================================================

write_files:

  - path: /opt/README.md
    owner: docker:docker
    permissions: "0640"
    content: |
      ============================================================
      Docker Host
      ============================================================

      Utilisateurs:

        admin
          Administration système

        docker
          Exécution des services Docker

      Repository:

        /opt/repository

      Docker Compose:

        /opt/docker/docker-compose.yml
        /opt/traefik/docker-compose.yml
        /opt/apps/docker-compose.yml
        /opt/data/docker-compose.yml

      Les fichiers docker-compose.yml sont copiés
      depuis le repository GitHub.

      ============================================================


# ============================================================
# MESSAGE FINAL
# ============================================================

final_message: |

  ============================================================
  CLOUD-INIT TERMINÉ
  ============================================================

  Hostname:
    docker-host

  Utilisateurs:
    admin
    docker

  Docker:
    Docker Engine installé
    Docker Compose installé
    Docker activé au démarrage

  Repository:
    /opt/repository

  Docker Compose:

    /opt/docker/docker-compose.yml
    /opt/traefik/docker-compose.yml
    /opt/apps/docker-compose.yml
    /opt/data/docker-compose.yml

  ============================================================
  INSTALLATION TERMINÉE
  ============================================================
```
