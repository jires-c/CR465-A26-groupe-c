  # ----------------------------------------------------------
  # Installation Docker Engine + Compose
  # ----------------------------------------------------------

 # - apt-get update

  #- apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  # ----------------------------------------------------------
  # Activation Docker
  # ----------------------------------------------------------

  - systemctl enable docker.service

  - systemctl enable containerd.service

  - systemctl start docker

  # ----------------------------------------------------------
  # Ajouter docker au groupe docker
  # ----------------------------------------------------------

  - usermod -aG docker docker

  # ----------------------------------------------------------
  # Création des répertoires applicatifs
  # ----------------------------------------------------------

  - mkdir -p /opt/docker
  - mkdir -p /opt/traefik
  - mkdir -p /opt/apps
  - mkdir -p /opt/data

  /opt/n8n
  /opt/keycloak
  /opt/moodle
  /opt/openappsec
  /opt/portainer
  /opt//postgresql
  /opt/opencast



  # ----------------------------------------------------------
  # Permissions
  # ----------------------------------------------------------

  - chown -R docker:docker /opt/docker
  - chown -R docker:docker /opt/traefik
  - chown -R docker:docker /opt/apps
  - chown -R docker:docker /opt/data

  - chmod 750 /opt/docker
  - chmod 750 /opt/traefik
  - chmod 750 /opt/apps
  - chmod 750 /opt/data

  # ----------------------------------------------------------
  # Activer QEMU Guest Agent
  # ----------------------------------------------------------

  - systemctl enable --now qemu-guest-agent

  # ----------------------------------------------------------
  # Vérification Docker
  # ----------------------------------------------------------

  - docker --version
  - docker compose version

  # ----------------------------------------------------------
  # Test Docker avec l'utilisateur docker
  # ----------------------------------------------------------

  - su - docker -c 'docker version'
  - su - docker -c 'docker compose version'

# ============================================================
# FICHIERS
# ============================================================

write_files:

  - path: /opt/docker/README.md
    owner: docker:docker
    permissions: "0640"
    content: |
      Environnement Docker

      Utilisateur:
        docker

      Répertoires:
        /opt/docker
        /opt/traefik
        /opt/apps
        /opt/data

      Docker Compose:
        docker compose

