#cloud-config

hostname: cr465-vm
manage_etc_hosts: true

users:
  - name: cr465
    gecos: CR465 Administrator
    groups:
      - sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL2T62+5ozGeKsBBGJoGxNpIP034bLqCfLrUKWLEL6yy root@el-petricho
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMOGp8S05dB0TeFQYkC5A6h27h0av1s+7/6oxRIpEODM ralimasi@el-petricho

ssh_pwauth: false

package_update: true

packages:
  - curl
  - git
  - ufw

runcmd:
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow OpenSSH
  - ufw --force enable
  - mkdir -p /opt/cr465
  - chown cr465:cr465 /opt/cr465
