# 1. Voir les branches
git branch

# 2. Créer une nouvelle branche et se positionner dessus
git switch -c ma-branche

# 3. Modifier tes fichiers...

# 4. Vérifier les modifications
git status

# 5. Ajouter les fichiers
git add .

# 6. Faire le commit
git commit -m "Ajout de ma modification"

# 7. Pousser la branche vers le dépôt distant
git push -u origin ma-branche