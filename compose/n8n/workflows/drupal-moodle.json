    {
      "id": "v5-normal",
      "name": "Une formation de demonstration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        490,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || {};\nconst a = (body.articles || []).find(x => x.sku);\nif (!body.email || !a) throw new Error('Commande sans email ou formation SKU');\nreturn [{json:{commande_id: body.commande_id, email: String(body.email).trim(), sku: String(a.sku).trim(), titre: a.titre}}];"
      }
    },
