local.file_match "docker_logs" {
  path_targets = [
    {
      __path__ = "/journaux/*/*-json.log",
      job      = "docker-rootless",
    },
  ]
}

loki.source.file "docker_logs" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker_json.receiver]
}

loki.process "docker_json" {
  stage.json {
    expressions = {
      message = "log",
      stream  = "stream",
      time    = "time",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  stage.output {
    source = "message"
  }

  stage.labels {
    values = {
      stream = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://groupec-loki:3100/loki/api/v1/push"
  }
}
