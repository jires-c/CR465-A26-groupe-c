# Exemple partageable : aucune valeur secrete n est incluse.
# Les mots de passe sont generes localement par /opt/GroupeC/deploy.sh.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MOODLE_DB=moodle
MOODLE_USER=moodle
KEYCLOAK_DB=keycloak
KEYCLOAK_USER=keycloak
DRUPAL_DB=drupal
DRUPAL_USER=drupal
N8N_DB=n8n
N8N_USER=n8n
OPENCAST_DB=opencast
OPENCAST_USER=opencast
# REDIS utilise son propre secret local, sans instance PostgreSQL.
# GRAFANA et LOKI: pas de base SQL supplementaire prevue.
# Les images ne supportent pas toutes *_PASSWORD_FILE: adapter service par service.
